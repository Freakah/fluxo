{
  "name": "fluxo",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted automatic expense tracker: connect a bank via open banking, sync transactions, understand spending.",
  "author": "Freakah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Freakah/fluxo.git"
  },
  "homepage": "https://github.com/Freakah/fluxo#readme",
  "bugs": {
    "url": "https://github.com/Freakah/fluxo/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "sync": "node --env-file-if-exists=.env scripts/sync.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env scripts/restore.ts",
    "reset-password": "node --env-file-if-exists=.env scripts/reset-password.ts",
    "gen-key": "node scripts/gen-key.ts",
    "scan:secrets": "node scripts/scan-secrets.ts",
    "screenshots": "playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "otpauth": "^9.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}

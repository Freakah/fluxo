# Copy to .env and adjust. Never commit .env.

# demo = simulated bank and synthetic data (default). live = real accounts via Enable Banking.
APP_MODE=demo
NODE_ENV=production

# Bind to localhost unless a reverse proxy with HTTPS is in front (see docs/DEPLOYMENT.md).
HOST=127.0.0.1
PORT=3000
# The exact URL users open. Must be https:// in production unless it is localhost.
PUBLIC_URL=http://localhost:3000

# Where the SQLite database, backups and the deletion log live.
DATA_DIR=./data

# 32 random bytes, base64. Generate with: npm run gen-key
# Encrypts stored bank-session references and 2-step secrets. Store a copy OUTSIDE the data directory/backups.
DATA_ENCRYPTION_KEY=

# Only the first account can register unless this is true.
ALLOW_REGISTRATION=false
# Set true only behind a reverse proxy you control (uses X-Forwarded-For for rate limiting).
TRUST_PROXY=false
SESSION_TTL_DAYS=30

# Background sync. Minimum 6h (banks typically allow ~4 background fetches per day).
SYNC_INTERVAL_HOURS=6
SCHEDULER_ENABLED=true

# Enable Banking (live mode). See docs/PROVIDERS.md.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_PATH=/path/outside/the/repo/enablebanking-private.pem
ENABLE_BANKING_ENVIRONMENT=sandbox
ENABLE_BANKING_API_URL=https://api.enablebanking.com
# Providers only accept https redirect URLs. This public relay page forwards to http://localhost:3000.
# Register exactly this URL with the provider. Leave empty if Fluxo itself is served over https.
BANK_REDIRECT_URL=https://freakah.github.io/fluxo/callback.html

LOG_LEVEL=info
